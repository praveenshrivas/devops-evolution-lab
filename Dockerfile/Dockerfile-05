FROM python:3.11-slim

WORKDIR /app

# Copy dependency file
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy app code
COPY . .

# Create non-root user
RUN useradd -m app
USER app

# Define entrypoint and default command
ENTRYPOINT ["python"]
CMD ["app.py"]
